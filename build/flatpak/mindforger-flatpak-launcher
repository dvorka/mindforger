# On a regular Linux install, MindForger's own Installer class seeds a fresh
# ~/mindforger-repository with default memory/stencils content copied from
# /usr/share/doc/mindforger (see lib/src/install/installer.cpp,
# FILE_PATH_DEFAULT_LINUX_SYSTEM_REPOSITORY). That is a hardcoded absolute path,
# checked with a plain file-existence test - inside the Flatpak sandbox /usr is the
# RUNTIME's /usr (org.kde.Platform), never this application's own content, which
# lives under /app. Since that literal path can never resolve to our content here,
# seed the SAME default content ourselves, before the real binary ever runs,
# mirroring exactly what Installer::initMindForgerRepository(copyDoc=true,
# copyStencils=true, ...) does. The same wrapper, for the same reason, is used by
# the Snap package - see build/snap/mindforger-launcher.

set -e

REPO="$HOME/mindforger-repository"
SEED="/app/share/doc/mindforger"

if [ ! -e "$REPO" ] && [ -d "$SEED" ]; then
    mkdir -p "$REPO"
    [ -d "$SEED/memory" ] && cp -r "$SEED/memory" "$REPO/"
    [ -d "$SEED/stencils" ] && cp -r "$SEED/stencils" "$REPO/"
fi

exec /app/bin/mindforger "$@"
