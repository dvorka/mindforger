# On a regular Linux install, MindForger's own Installer class seeds a fresh
# ~/mindforger-repository with default memory/stencils content copied from
# /usr/share/doc/mindforger (see lib/src/install/installer.cpp,
# FILE_PATH_DEFAULT_LINUX_SYSTEM_REPOSITORY). That is a hardcoded absolute host
# path, checked with a plain file-existence test - it is unreachable under snap
# confinement: for strict, /usr inside the mount namespace is the BASE snap's
# /usr, not this snap's own bundled content, and snapcraft cannot bind-mount into
# it; for classic, it is the real host path, populated only if the .deb happens
# to also be installed there. Since neither confinement mode can make that literal
# path resolve to our content, seed the SAME default content ourselves here,
# before the real binary ever runs, mirroring exactly what Installer::
# initMindForgerRepository(copyDoc=true, copyStencils=true, ...) does.

set -e

REPO="$HOME/mindforger-repository"
SEED="$SNAP/share/doc/mindforger"

if [ ! -e "$REPO" ] && [ -d "$SEED" ]; then
    mkdir -p "$REPO"
    [ -d "$SEED/memory" ] && cp -r "$SEED/memory" "$REPO/"
    [ -d "$SEED/stencils" ] && cp -r "$SEED/stencils" "$REPO/"
fi

exec "$SNAP/bin/mindforger" "$@"
